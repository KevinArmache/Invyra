# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/invyra"

# Clé de signature des sessions better-auth.
# Générez-en une : openssl rand -base64 32
BETTER_AUTH_SECRET=""

# URL publique de l'application. Sert à construire les liens d'invitation
# envoyés aux convives — en production, mettez le domaine réel.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Envoi des emails d'invitation (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Upload des photos des invitations (Vercel Blob).
# Vercel > Storage > Blob > créer un store : la variable est ajoutée au projet.
# Sans elle, l'éditeur ne propose que le collage d'URL d'image.
BLOB_READ_WRITE_TOKEN=""
