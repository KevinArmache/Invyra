// ─────────────────────────────────────────────────────────────────────────────
// Invyra — schéma de données
//
// L'authentification est gérée par better-auth : les modèles Session, Account
// et Verification sont ceux qu'il attend, ne les renommez pas sans mettre à
// jour utils/auth/server.js.
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

// ─── Utilisateur ─────────────────────────────────────────────────────────────

model User {
  id String @id @default(cuid())

  email         String  @unique
  emailVerified Boolean @default(false)
  name          String?
  image         String?

  company String?
  phone   String?

  // Champs métier, exposés à better-auth via `user.additionalFields`.
  role      String  @default("user") // "user" | "admin"
  plan      String  @default("free") // "free" | "premium"
  suspended Boolean @default(false)

  /// Hash bcrypt hérité de l'authentification maison. Plus jamais écrit : le
  /// mot de passe vit désormais dans Account.password (providerId
  /// "credential"). Conservé le temps que tous les comptes soient migrés par
  /// prisma/migrate-passwords.mjs, puis supprimable.
  legacyPassword String? @map("password")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  events         Event[]
  templates      Template[]
  collaborations EventCollaborator[]
  sessions       Session[]
  accounts       Account[]
  templateVotes  TemplateVote[]

  @@map("users")
}

// ─── better-auth : sessions, comptes, vérifications ─────────────────────────

model Session {
  id String @id @default(cuid())

  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id String @id @default(cuid())

  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id String @id @default(cuid())

  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ─── Modèles d'invitation ────────────────────────────────────────────────────

enum TemplateStatus {
  draft
  in_progress
  completed
}

model Template {
  id               String  @id @default(cuid())
  userId           String?
  eventId          String? @unique
  sourceTemplateId String?

  name   String
  status TemplateStatus? @default(draft)
  config Json

  /// Groupe du modèle dans la galerie (voir lib/invitation/categories.js) :
  /// "wedding", "birthday", "party"… ; null = sans catégorie.
  category String?

  // Mis en avant sur la page d'accueil publique (choisi par un admin).
  featured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // userId est nullable et sans cascade : un modèle partagé survit à la
  // suppression de son auteur.
  user           User?      @relation(fields: [userId], references: [id])
  event          Event?     @relation("EventTemplateCopy", fields: [eventId], references: [id], onDelete: Cascade)
  sourceTemplate Template?  @relation("TemplateCopies", fields: [sourceTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eventCopies    Template[] @relation("TemplateCopies")
  votes          TemplateVote[]

  @@index([userId])
  @@index([featured])
  @@index([category])
  @@map("templates")
}

// ─── Votes sur les modèles ───────────────────────────────────────────────────

/// Vote d'un utilisateur sur un modèle public : un seul par personne (voir
/// app/actions/feedback.js). Les « j'aime » sont publics, avec le nom de
/// leur auteur ; les « je n'aime pas » ne sont nominatifs que pour un admin.
model TemplateVote {
  id         String @id @default(cuid())
  templateId String
  userId     String

  kind String // "like" | "dislike"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
  @@index([userId])
  @@map("template_votes")
}

// ─── Événements ──────────────────────────────────────────────────────────────

model Event {
  id     String @id @default(cuid())
  userId String

  title         String
  description   String?
  eventDate     DateTime?
  /// Résumé du lieu : la première étape de l'itinéraire, ou le texte saisi
  /// avant l'itinéraire. Lu par les e-mails, les PDF et les modèles.
  location      String?
  /// Étapes de l'événement, dans l'ordre (voir lib/itinerary.js).
  itinerary     Json?
  time          String?
  dressCode     String?
  customMessage String?
  /// Numéro que les invités peuvent appeler pour toute question, affiché
  /// sur chaque invitation (voir lib/invitation/document.js).
  contactPhone  String?

  animationConfig Json?
  /// Déprécié : le design vit dans Template (relation templateCopy).
  /// Encore lu en repli pour les événements créés avant la bascule.
  invitationTemplate Json?
  emailTemplate      String?

  status   String  @default("draft") // "draft" | "active" | "archived"
  autoSend Boolean @default(false)

  /// Lien secret de l'équipe d'accueil (/check-in/<jeton>), créé à la
  /// demande et régénérable par l'hôte (voir app/actions/checkin.js).
  checkInToken String? @unique

  /// L'hôte peut couper le livre d'or ou le mur de photos des invités.
  guestbookEnabled Boolean @default(true)
  photosEnabled    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  guests            Guest[]
  collaborators     EventCollaborator[]
  templateCopy      Template?           @relation("EventTemplateCopy")
  guestbookMessages GuestbookMessage[]
  photos            EventPhoto[]

  @@index([userId])
  @@map("events")
}

model EventCollaborator {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  role        String   @default("editor") // "editor" | "viewer"
  inviteToken String?  @unique
  accepted    Boolean  @default(false)
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_collaborators")
}

// ─── Invités ─────────────────────────────────────────────────────────────────

model Guest {
  id      String @id @default(cuid())
  eventId String

  name                String
  email               String
  phone               String?
  dietaryRestrictions String?
  /// Déprécié : remplacé par `seats` (voir 004-guest-ticket-checkin.sql).
  plusOne             Boolean @default(false)
  /// Mot de l'invité pour les hôtes, laissé avec sa réponse.
  notes               String?

  /// Places réservées par l'hôte, l'invité compris.
  seats          Int  @default(1)
  /// Personnes annoncées par l'invité (1 à `seats`) ; null tant qu'il ne
  /// l'a pas précisé, on compte alors toutes ses places.
  attendingCount Int?

  invitationToken String  @unique
  rsvpStatus      String? // "confirmed" | "declined" | "maybe" | null

  /// Code du billet d'entrée (lib/tickets.js). Distinct du jeton
  /// d'invitation : montrer son billet ne donne pas le droit de modifier sa
  /// réponse.
  ticketCode     String?   @unique
  checkedInAt    DateTime?
  checkedInCount Int?

  invitationSentAt   DateTime?
  emailSentAt        DateTime?
  whatsappSentAt     DateTime?
  invitationViewedAt DateTime?
  rsvpRespondedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestbookMessages GuestbookMessage[]
  photos            EventPhoto[]

  @@unique([eventId, email])
  @@index([eventId, rsvpStatus])
  @@map("guests")
}

// ─── Souvenirs : livre d'or et photos des invités ───────────────────────────

model GuestbookMessage {
  id      String @id @default(cuid())
  eventId String
  guestId String

  message String
  /// Masqué par l'hôte : il n'apparaît plus aux invités.
  hidden  Boolean @default(false)

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([guestId])
  @@map("guestbook_messages")
}

/// Photo ou vidéo partagée par un invité (voir lib/media/memories.js).
model EventPhoto {
  id      String @id @default(cuid())
  eventId String
  guestId String

  /// Fichier sur Vercel Blob, sous memories/<eventId>/.
  url      String
  pathname String
  kind     String  @default("photo") // "photo" | "video"
  /// Aperçu d'une vidéo, sous memories/<eventId>/posters/ ; absent si le
  /// navigateur de l'invité n'a pas pu le produire.
  posterUrl String?
  /// Durée d'une vidéo, en secondes.
  duration Int?
  width    Int?
  height   Int?
  hidden   Boolean @default(false)

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([guestId])
  @@map("event_photos")
}
